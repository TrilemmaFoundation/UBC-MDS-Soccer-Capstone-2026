# =============================================================================
# Environment Variables — copy this file to .env and fill in values
# NEVER commit .env or service account JSON keys to git
# =============================================================================

# GCP
GCP_PROJECT_ID=football-capstone-mds-495504
GOOGLE_APPLICATION_CREDENTIALS=

# The Dagster and Chatbot environments should use different .env files for security concerns.
# For the local Dagster environment, export the Dagster key:
# GOOGLE_APPLICATION_CREDENTIALS=./dagster-service-account-key.json

# For the local Chatbot environment, export the Chatbot key:
# GOOGLE_APPLICATION_CREDENTIALS=./chatbot-service-account-key.json

# GCS buckets
INGESTION_GCS_BUCKET=football-analytics-mds2026
ML_GCS_BUCKET=football-analytics-mds2026-ml-bucket

# BigQuery datasets
INGESTION_BQ_DATASET=raw_statsbomb
DBT_INTERMEDIATE_DATASET=dbt_intermediate
ML_BQ_DATASET=analytics

# StatsBomb credentials (optional)
# If both are set, the paid StatsBomb API is used (full historical data).
# If either is missing, statsbombpy falls back to the free open data (GitHub-hosted).
# Leave blank or omit if you only need open data.
SB_USERNAME=
SB_PASSWORD=

# Groq LLM (get key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Looker Studio dashboard embed URL
LOOKER_STUDIO_URL=https://datastudio.google.com/embed/reporting/6ed7dbc3-7bbf-4659-ad60-393443a4587c/page/If9xF

# Django (set to False in production)
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-in-production
