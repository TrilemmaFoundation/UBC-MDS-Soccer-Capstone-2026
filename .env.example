# =============================================================================
# Environment Variables — copy this file to .env and fill in values
# NEVER commit .env or service-account-key.json to git
# =============================================================================

# GCP
GCP_PROJECT_ID=football-capstone-mds-496219
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# GCS buckets
INGESTION_GCS_BUCKET=football-analytics-mds2026
